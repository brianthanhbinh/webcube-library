<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Sphere 5x3x3</Name>
        <Menu>Cubic\Spheres\Sphere 5x3x3</Menu>
        <Added>2026-11-22</Added>
    </Interface>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-3/10; -1/10; 1/10; 3/10" >
        <Axis NormVector = "1; 0; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "0; 1; 0" />
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Sphere mesh 8.xml" W = "0.5" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <Macro Name = "L " Public = "1" Description = "L - clockwise, L2 - double, L' - counter-clockwise" > <Turn Axis = "0" Layer = "0" Angle = "Pi/2" /> </Macro>
        <Macro Name = "L2" Public = "0" > <Turn Axis = "0" Layer = "0" Angle = "Pi" /> </Macro>
        <Macro Name = "L'" Public = "0" > <Turn Axis = "0" Layer = "0" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "R " Public = "1" Description = "R - clockwise, R2 - double, R' - counter-clockwise" > <Turn Axis = "0" Layer = "4" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "R2" Public = "0" > <Turn Axis = "0" Layer = "4" Angle = "Pi" /> </Macro>
        <Macro Name = "R'" Public = "0" > <Turn Axis = "0" Layer = "4" Angle = "Pi/2" /> </Macro>
        <Macro Name = "F " Public = "1" Description = "F - clockwise, F2 - double, F' - counter-clockwise" > <Turn Axis = "1" Layer = "0" Angle = "Pi/2" /> </Macro>
        <Macro Name = "F2" Public = "0" > <Turn Axis = "1" Layer = "0" Angle = "Pi" /> </Macro>
        <Macro Name = "F'" Public = "0" > <Turn Axis = "1" Layer = "0" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "S " Public = "0" > <Turn Axis = "1" Layer = "1" Angle = "Pi/2" /> </Macro>
        <Macro Name = "S2" Public = "0" > <Turn Axis = "1" Layer = "1" Angle = "Pi" /> </Macro>
        <Macro Name = "S'" Public = "0" > <Turn Axis = "1" Layer = "1" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "B " Public = "1" Description = "B - clockwise, B2 - double, B' - counter-clockwise" > <Turn Axis = "1" Layer = "2" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "B2" Public = "0" > <Turn Axis = "1" Layer = "2" Angle = "Pi" /> </Macro>
        <Macro Name = "B'" Public = "0" > <Turn Axis = "1" Layer = "2" Angle = "Pi/2" /> </Macro>
        <Macro Name = "D " Public = "1" Description = "D - clockwise, D2 - double, D' - counter-clockwise" > <Turn Axis = "2" Layer = "0" Angle = "Pi/2" /> </Macro>
        <Macro Name = "D2" Public = "0" > <Turn Axis = "2" Layer = "0" Angle = "Pi" /> </Macro>
        <Macro Name = "D'" Public = "0" > <Turn Axis = "2" Layer = "0" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "E " Public = "0" > <Turn Axis = "2" Layer = "1" Angle = "Pi/2" /> </Macro>
        <Macro Name = "E2" Public = "0" > <Turn Axis = "2" Layer = "1" Angle = "Pi" /> </Macro>
        <Macro Name = "E'" Public = "0" > <Turn Axis = "2" Layer = "1" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U " Public = "1" Description = "U - clockwise, U2 - double, U' - counter-clockwise" > <Turn Axis = "2" Layer = "2" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U2" Public = "0" > <Turn Axis = "2" Layer = "2" Angle = "Pi" /> </Macro>
        <Macro Name = "U'" Public = "0" > <Turn Axis = "2" Layer = "2" Angle = "Pi/2" /> </Macro>

        <Macro Name = "RandomRound" >
            <Turn Axis = "0" Layer = "Random(5)" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "1" Layer = "Random(3)" Angle = "Pi/2 * (Random(3) + 1)" />
            <Turn Axis = "2" Layer = "Random(3)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "110 random turns" >
            <ExecMacro MacroName = "RandomRound" Repeat = "36" />
        </Macro>
    </Macros>
</xml>
