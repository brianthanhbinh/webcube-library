<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cylinder 8x8x8</Name>
        <Menu>Cubic\Cylinders\Cylinder 8x8x8</Menu>
        <Added>2026-11-24</Added>
    </Interface>

    <Axes TurningAngles = "Pi" PlaneDistances = "-6/6; -4/6; -2/6; 0; 2/6; 4/6; 6/6" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-6/6; -4/6; -2/6; 0; 2/6; 4/6; 6/6" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cylinder.xml" Wr = "1.333333" Wh = "1.333333" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <Macro Name = "L2" Public = "1" Description = "L2 - half turn of the first layer across the circle" > <Turn Axis = "0" Layer = "0" Angle = "Pi" /> </Macro>
        <Macro Name = "R2" Public = "1" Description = "R2 - half turn of the last layer across the circle" > <Turn Axis = "0" Layer = "7" Angle = "Pi" /> </Macro>
        <Macro Name = "F2" Public = "1" Description = "F2 - half turn of the first layer across the circle" > <Turn Axis = "1" Layer = "0" Angle = "Pi" /> </Macro>
        <Macro Name = "B2" Public = "1" Description = "B2 - half turn of the last layer across the circle" > <Turn Axis = "1" Layer = "7" Angle = "Pi" /> </Macro>
        <Macro Name = "D " Public = "1" Description = "D - first layer along the height clockwise, D2 - double, D' - counter-clockwise" > <Turn Axis = "2" Layer = "0" Angle = "Pi/2" /> </Macro>
        <Macro Name = "D2" Public = "0" > <Turn Axis = "2" Layer = "0" Angle = "Pi" /> </Macro>
        <Macro Name = "D'" Public = "0" > <Turn Axis = "2" Layer = "0" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U " Public = "1" Description = "U - last layer along the height clockwise, U2 - double, U' - counter-clockwise" > <Turn Axis = "2" Layer = "7" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U2" Public = "0" > <Turn Axis = "2" Layer = "7" Angle = "Pi" /> </Macro>
        <Macro Name = "U'" Public = "0" > <Turn Axis = "2" Layer = "7" Angle = "Pi/2" /> </Macro>

        <Macro Name = "RandomRound" >
            <Turn Axis = "0" Layer = "Random(8)" Angle = "Pi" />
            <Turn Axis = "1" Layer = "Random(8)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(8)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "240 random turns" >
            <ExecMacro MacroName = "RandomRound" Repeat = "80" />
        </Macro>
    </Macros>
</xml>
