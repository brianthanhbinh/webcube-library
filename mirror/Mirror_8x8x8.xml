<?xml version="1.0" encoding="UTF-8"?>
<xml Data_Version="2">

    <Interface>
        <Name>Mirror Cube 8x8x8</Name>
        <Menu>Cubic\Mirror\8x8x8</Menu>
        <Inventor>Hidetoshi Takeji</Inventor>
        <Programmer>Brian</Programmer>
        <Added>2026-11-24</Added>
    </Interface>

    <Axes
        TurningAngles="2*Pi/4"
        PlaneDistances="-0.375; -0.25; -0.125; 0; 0.125; 0.25; 0.375">

        <Axis NormVector="1;0;0"/>
        <Axis NormVector="0;1;0"/>
        <Axis NormVector="0;0;1"/>

    </Axes>

    <Figure>
        <LoadFrom File="Figures\Mirror.xml" W="0.5"/>
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <Macro Name = "R " Public = "1" Description = "R face turn"> <Turn Axis = "0" Layer = "7" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "R'" Public = "0"> <Turn Axis = "0" Layer = "7" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "2R " Public = "1" Description = "2R slice turn"> <Turn Axis = "0" Layer = "6" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "2R'" Public = "0"> <Turn Axis = "0" Layer = "6" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "3R " Public = "1" Description = "3R slice turn"> <Turn Axis = "0" Layer = "5" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "3R'" Public = "0"> <Turn Axis = "0" Layer = "5" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "4R " Public = "1" Description = "4R slice turn"> <Turn Axis = "0" Layer = "4" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "4R'" Public = "0"> <Turn Axis = "0" Layer = "4" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "L " Public = "1" Description = "L face turn"> <Turn Axis = "0" Layer = "0" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "L'" Public = "0"> <Turn Axis = "0" Layer = "0" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "2L " Public = "1" Description = "2L slice turn"> <Turn Axis = "0" Layer = "1" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "2L'" Public = "0"> <Turn Axis = "0" Layer = "1" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "3L " Public = "1" Description = "3L slice turn"> <Turn Axis = "0" Layer = "2" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "3L'" Public = "0"> <Turn Axis = "0" Layer = "2" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "4L " Public = "1" Description = "4L slice turn"> <Turn Axis = "0" Layer = "3" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "4L'" Public = "0"> <Turn Axis = "0" Layer = "3" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "U " Public = "1" Description = "U face turn"> <Turn Axis = "1" Layer = "7" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "U'" Public = "0"> <Turn Axis = "1" Layer = "7" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "2U " Public = "1" Description = "2U slice turn"> <Turn Axis = "1" Layer = "6" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "2U'" Public = "0"> <Turn Axis = "1" Layer = "6" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "3U " Public = "1" Description = "3U slice turn"> <Turn Axis = "1" Layer = "5" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "3U'" Public = "0"> <Turn Axis = "1" Layer = "5" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "4U " Public = "1" Description = "4U slice turn"> <Turn Axis = "1" Layer = "4" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "4U'" Public = "0"> <Turn Axis = "1" Layer = "4" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "D " Public = "1" Description = "D face turn"> <Turn Axis = "1" Layer = "0" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "D'" Public = "0"> <Turn Axis = "1" Layer = "0" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "2D " Public = "1" Description = "2D slice turn"> <Turn Axis = "1" Layer = "1" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "2D'" Public = "0"> <Turn Axis = "1" Layer = "1" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "3D " Public = "1" Description = "3D slice turn"> <Turn Axis = "1" Layer = "2" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "3D'" Public = "0"> <Turn Axis = "1" Layer = "2" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "4D " Public = "1" Description = "4D slice turn"> <Turn Axis = "1" Layer = "3" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "4D'" Public = "0"> <Turn Axis = "1" Layer = "3" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "F " Public = "1" Description = "F face turn"> <Turn Axis = "2" Layer = "7" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "F'" Public = "0"> <Turn Axis = "2" Layer = "7" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "2F " Public = "1" Description = "2F slice turn"> <Turn Axis = "2" Layer = "6" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "2F'" Public = "0"> <Turn Axis = "2" Layer = "6" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "3F " Public = "1" Description = "3F slice turn"> <Turn Axis = "2" Layer = "5" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "3F'" Public = "0"> <Turn Axis = "2" Layer = "5" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "4F " Public = "1" Description = "4F slice turn"> <Turn Axis = "2" Layer = "4" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "4F'" Public = "0"> <Turn Axis = "2" Layer = "4" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "B " Public = "1" Description = "B face turn"> <Turn Axis = "2" Layer = "0" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "B'" Public = "0"> <Turn Axis = "2" Layer = "0" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "2B " Public = "1" Description = "2B slice turn"> <Turn Axis = "2" Layer = "1" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "2B'" Public = "0"> <Turn Axis = "2" Layer = "1" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "3B " Public = "1" Description = "3B slice turn"> <Turn Axis = "2" Layer = "2" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "3B'" Public = "0"> <Turn Axis = "2" Layer = "2" Angle = "2*Pi/4" /> </Macro>
        <Macro Name = "4B " Public = "1" Description = "4B slice turn"> <Turn Axis = "2" Layer = "3" Angle = "-2*Pi/4" /> </Macro>
        <Macro Name = "4B'" Public = "0"> <Turn Axis = "2" Layer = "3" Angle = "2*Pi/4" /> </Macro>

        <Macro Name = "RandomTurn" >
            <Turn Axis = "Random(3)" Layer = "Random(8)" Angle = "2*Pi/4 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Scramble Mirror 8x8x8" Sequence = "120 random turns" >
            <ExecMacro MacroName = "RandomTurn" Repeat = "120" />
        </Macro>
    </Macros>
</xml>
