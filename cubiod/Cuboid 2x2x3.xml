<?xml version = "1.0" encoding = "UTF-8"?>
<xml Data_Version = "2" >

    <Interface>
        <Name>Cuboid 2x2x3</Name>
        <Menu>Cubic\Cuboids\Cuboid 2x2x3</Menu>
        <Added>2026-11-21</Added>
    </Interface>

    <Axes TurningAngles = "Pi" PlaneDistances = "0" >
        <Axis NormVector = "1; 0; 0" />
        <Axis NormVector = "0; 1; 0" />
    </Axes>

    <Axes TurningAngles = "Pi / 2" PlaneDistances = "-1/6; 1/6" >
        <Axis NormVector = "0; 0; 1" />
    </Axes>

    <Figure>
        <LoadFrom File = "Figures\Cuboid.xml" Wx = "0.333333" Wy = "0.333333" Wz = "0.500000" />
        <SplitByAxes/>
        <RemoveGrayParts/>
    </Figure>

    <Macros>
        <Macro Name = "L2" Public = "1" Description = "L2 - half turn of the first layer of direction x" > <Turn Axis = "0" Layer = "0" Angle = "Pi" /> </Macro>
        <Macro Name = "R2" Public = "1" Description = "R2 - half turn of the last layer of direction x" > <Turn Axis = "0" Layer = "1" Angle = "Pi" /> </Macro>
        <Macro Name = "F2" Public = "1" Description = "F2 - half turn of the first layer of direction y" > <Turn Axis = "1" Layer = "0" Angle = "Pi" /> </Macro>
        <Macro Name = "B2" Public = "1" Description = "B2 - half turn of the last layer of direction y" > <Turn Axis = "1" Layer = "1" Angle = "Pi" /> </Macro>
        <Macro Name = "D " Public = "1" Description = "D - first layer of direction z clockwise, D2 - double, D' - counter-clockwise" > <Turn Axis = "2" Layer = "0" Angle = "Pi/2" /> </Macro>
        <Macro Name = "D2" Public = "0" > <Turn Axis = "2" Layer = "0" Angle = "Pi" /> </Macro>
        <Macro Name = "D'" Public = "0" > <Turn Axis = "2" Layer = "0" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U " Public = "1" Description = "U - last layer of direction z clockwise, U2 - double, U' - counter-clockwise" > <Turn Axis = "2" Layer = "2" Angle = "-Pi/2" /> </Macro>
        <Macro Name = "U2" Public = "0" > <Turn Axis = "2" Layer = "2" Angle = "Pi" /> </Macro>
        <Macro Name = "U'" Public = "0" > <Turn Axis = "2" Layer = "2" Angle = "Pi/2" /> </Macro>

        <Macro Name = "RandomRound" >
            <Turn Axis = "0" Layer = "Random(2)" Angle = "Pi" />
            <Turn Axis = "1" Layer = "Random(2)" Angle = "Pi" />
            <Turn Axis = "2" Layer = "Random(3)" Angle = "Pi/2 * (Random(3) + 1)" />
        </Macro>
        <Macro Name = "Scramble" Public = "1" Description = "Replacing of standard scrambling" Sequence = "100 random turns" >
            <ExecMacro MacroName = "RandomRound" Repeat = "33" />
        </Macro>
    </Macros>
</xml>
